<?php
/**
 * @updated_for_magento_2.4.9_and_php_8.4
 * @var \Magento\Backend\Block\Template $block
 */

$paymentInfo = $block->getPaymentInfo();
$methodCode = $block->getPaymentMethod();
?>

<?php if ($methodCode === 'paghiper_boleto'): ?>
    <div class="admin__page-section-item-content paghiper-admin-block" style="margin-top: 10px;">
        <a href="<?= $block->escapeUrl($paymentInfo['url']); ?>" 
           target="_blank" 
           rel="noopener" 
           class="action-secondary" 
           style="text-decoration: none; display: inline-block; padding: 7px 15px;">
            <span><?= $block->escapeHtml(__($paymentInfo['texto'] ?? 'Visualizar Boleto')); ?></span>
        </a>
    </div>

<?php elseif ($methodCode === 'paghiper_pix'): ?>
    <div class="admin__page-section-item-content paghiper-admin-block" style="margin-top: 10px;">
        <button type="button" class="action-secondary btn-paghiper-pix" data-trigger="trigger-admin-pix">
            <span><?= $block->escapeHtml(__($paymentInfo['texto'] ?? 'Visualizar QR Code PIX')); ?></span>
        </button>

        <div data-bind="mageInit: {
            'Magento_Ui/js/modal/modal':{
                'type': 'popup',
                'modalClass': 'modalpix',
                'title': '<?= $block->escapeJs(__('QR Code do Pedido')); ?>',
                'trigger': '[data-trigger=trigger-admin-pix]',
                'responsive': true
            }}">
            <div class="content" style="text-align: center; padding: 20px 0;">
                <img src="<?= $block->escapeUrl($paymentInfo['url']); ?>" 
                     alt="<?= $block->escapeHtmlAttr(__('QR Code Pix PagHiper')); ?>"
                     style="max-width: 250px; height: auto;">
            </div>
        </div>
    </div>
<?php endif; ?>