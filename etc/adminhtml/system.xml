<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            
            <group id="paghiper_general" translate="label comment" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>PagHiper - Configurações Gerais</label>
                
                <field id="active" translate="label comment" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Habilitado</label>
                    <comment>Habilitar ou desabilitar o módulo PagHiper globalmente.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                
                <field id="api_key" translate="label comment" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Chave API</label>
                    <frontend_class>required-entry</frontend_class>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>
                
                <field id="token" translate="label comment" type="text" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Token</label>
                    <frontend_class>required-entry</frontend_class>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>
                
                <field id="dias_vencimento" translate="label comment" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Dias de Validade</label>
                    <comment>Dias de validade padrão para o vencimento do boleto.</comment>
                    <frontend_class>required-entry validate-digits validate-zero-or-greater</frontend_class>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>
                
                <field id="invoice_after_confirmation" translate="label comment" type="select" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Faturar Após Pagamento Confirmado?</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>

                <field id="bypass_cron_expiration" translate="label comment" type="select" sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="0">
                  <label>Ignorar Cancelamento Automático do Magento</label>
                  <comment>Se ativado, impede que o Cron nativo do Magento cancele pedidos Pix/Boleto por ociosidade, deixando que apenas a PagHiper gerencie o vencimento.</comment>
                  <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                  <depends>
                    <field id="active">1</field>
                  </depends>
                </field>

                <field id="debug_log" translate="label comment" type="select" sortOrder="8" showInDefault="1" showInWebsite="1" showInStore="0">
                  <label>Habilitar Log de Depuração</label>
                  <comment>Grava registros detalhados das notificações no arquivo var/log/paghiper_webhook.log para análise técnica.</comment>
                  <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                  <depends>
                    <field id="active">1</field>
                  </depends>
                </field>
            </group>

            <group id="paghiper_boleto" translate="label comment" sortOrder="101" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>PagHiper - Configurações de Boleto</label>
                
                <field id="active" translate="label comment" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Habilitado</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="title" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Título do Meio de Pagamento</label>
                </field>
                
                <field id="percentual_multa" translate="label comment" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Percentual de Multa</label>
                    <comment>Máximo de 2%, apenas valores inteiros.</comment>
                    <frontend_class>validate-zero-or-greater</frontend_class>
                </field>
                
                <field id="juros_atraso" translate="label comment" type="text" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Juros por Atraso</label>
                    <comment>Máximo de 1% de juros ao mês (cobrado proporcionalmente aos dias de atraso).</comment>
                    <frontend_class>validate-zero-or-greater</frontend_class>
                </field>
                
                <field id="dias_pagamento_antecipado" translate="label comment" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Número de Dias do Desconto</label>
                    <comment>Número de dias de antecedência para receber o desconto extra.</comment>
                    <frontend_class>validate-zero-or-greater</frontend_class>
                </field>
                
                <field id="valor_desconto_antecipado" translate="label comment" type="text" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Valor do Desconto para Pagamento Antecipado</label>
                    <comment>Valor em reais que será deduzido do boleto.</comment>
                    <frontend_class>validate-zero-or-greater</frontend_class>
                </field>
                
                <field id="numero_apos_vencimento" translate="label comment" type="text" sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Número de Dias Após o Vencimento</label>
                    <comment>Número máximo de dias em que o boleto pode ser pago após a data de vencimento.</comment>
                    <frontend_class>required-entry validate-digits</frontend_class>
                </field>

                <field id="order_status" translate="label" type="select" sortOrder="8" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Novo Status do Pedido</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\NewStatus</source_model>
                </field>
            </group>

            <group id="paghiper_pix" translate="label comment" sortOrder="102" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>PagHiper - Configurações do Pix</label>
                
                <field id="active" translate="label comment" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Habilitado</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="title" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Título do Meio de Pagamento</label>
                </field>
                
                <field id="pix_expiration" translate="label comment" type="text" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Tempo de Expiração em minutos</label>
                    <comment>Expiração do Pix em minutos (Insira um valor entre 1 a 576000 minutos).</comment>
                    <backend_model>Paghiper\Magento2\Model\Config\Backend\PixExpiration</backend_model>
                    <frontend_class>required-entry validate-digits validate-zero-or-greater</frontend_class>
                </field>

                <field id="order_status" translate="label" type="select" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Novo Status do Pedido</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\NewStatus</source_model>
                </field>
            </group>
            
        </section>
    </system>
</config>